{
  "config": {
    "flow_title": "{name} ({host})",
    "step": {
      "user": {
        "description": "How would you like to add your Swidget device?",
        "menu_options": {
          "scan": "Scan the network for devices",
          "manual": "Enter device details manually"
        }
      },
      "manual": {
        "description": "Enter the host or IP address of your Swidget device.",
        "data": {
          "host": "[%key:common::config_flow::data::host%]"
        }
      },
      "scan": {
        "description": "Choose a discovered Swidget device.",
        "data": {
          "device": "Device"
        }
      },
      "credentials": {
        "description": "{name} ({host}) requires a secure connection. Enter the device credentials.",
        "data": {
          "token_name": "Token header name",
          "secret_key": "Secret key"
        }
      },
      "discovery_confirm": {
        "description": "Set up {name} ({host})?"
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "no_devices_found": "[%key:common::config_flow::abort::no_devices_found%]",
      "invalid_discovery_info": "Invalid discovery information received."
    }
  }
}
